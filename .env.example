# Server & Runtime Configuration
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Cloudflare Origin Guard (Secret header required in production)
CLOUDFLARE_ORIGIN_SECRET=local-dev-origin-secret-change-in-prod-64chars-long-example

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/booking_dev?schema=public&connection_limit=10

# Redis & BullMQ (Upstash or local Redis)
# In production with Upstash: rediss://default:xxxx@xxxx.upstash.io:6379
UPSTASH_REDIS_URL=redis://localhost:6379

# Authentication & Cryptography
JWT_SECRET=dev-jwt-access-secret-minimum-32-chars-long-strictly-enforced!
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-minimum-32-chars-long-strictly-enforced!
ACCESS_TOKEN_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=604800

# Google Cloud Storage (GCS)
GCP_PROJECT_ID=booking-dev-project
GCS_BUCKET_PRIVATE=booking-dev-private-uploads
GCS_BUCKET_PUBLIC=booking-dev-public-assets
# When using fake-gcs-server locally:
STORAGE_EMULATOR_HOST=http://localhost:4443

# Email & Notifications (Nodemailer)
# Locally points to Mailpit; in production: smtp://user:pass@smtp.resend.com:587
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=no-reply@booking.local

